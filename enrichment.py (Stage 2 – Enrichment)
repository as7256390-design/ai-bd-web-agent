def enrich_profiles(df):

    def infer_email(name, company):
        domain = company.replace(" ", "").lower()
        first, last = name.split()[0], name.split()[-1]
        return f"{first.lower()}.{last.lower()}@{domain}.com"

    df["Email"] = df.apply(
        lambda x: infer_email(x["Name"], x["Company"]), axis=1
    )

    df["Person Location"] = df["Person Location"]
    df["Company HQ"] = df["Company HQ"]

    return df
